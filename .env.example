# Personal Finance Tracker - Environment Configuration
# Copy to .env and fill in. NEVER commit your real .env.

# Flask
FLASK_ENV=production
FLASK_DEBUG=0

# Security — set a long random string in production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FPU_SECRET_KEY=change-me-in-production
FPU_TOKEN_SALT=change-me-too

# Database (SQLite file path; keep instance/ in VCS but treat as scratch space)
DATABASE_URI=sqlite:///finance.db

# Optional: PostgreSQL in production (Render/Railway/etc.)
# FPU_DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Optional: email provider for password resets (SMTP)
# FPU_SMTP_HOST=
# FPU_SMTP_PORT=
# FPU_SMTP_USER=
# FPU_SMTP_PASS=
# FPU_EMAIL_FROM=noreply@yourdomain.com

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
